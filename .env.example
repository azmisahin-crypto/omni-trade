# Bu dosyayi .env olarak kopyala, gercek degerleri gir. .env asla git'e girmez.

EXCHANGE_KEY=
EXCHANGE_SECRET=

# Telegram: @BotFather -> /newbot -> token'i buraya yapistir
TELEGRAM_TOKEN=
# @userinfobot ile kendi chat id'ini ogren
TELEGRAM_CHAT_ID=

# Faz 14: dashboard config/config.yaml'da web_auth.enabled: true ise
# bu sifre zorunlu (kullanici adi config.yaml'daki web_auth.username).
WEB_AUTH_PASSWORD=
